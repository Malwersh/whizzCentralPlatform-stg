{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/WizzUser_users_staging",
      "Condition": {
        "Null": {
          "dynamodb:Attributes": "false"
        },
        "ForAllValues:StringEquals": {
          "dynamodb:Attributes": [
            "userId",
            "notification_settings",
            "isActive",
            "deletionRequestId",
            "marketing_consent"
          ]
        }
      }
    }
  ]
}
