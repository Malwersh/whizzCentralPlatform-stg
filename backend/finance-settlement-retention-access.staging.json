{
  "targetRole": "arn:aws:iam::699561669180:role/staging-account-deletion-WorkerRole-u5xpbVRU9G0Q",
  "policyName": "SettlementRetention113",
  "policyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "PinRetainedSettlementSources",
        "Effect": "Allow",
        "Action": [
          "dynamodb:ConditionCheckItem"
        ],
        "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-MerchantPlatform",
        "Condition": {
          "ForAllValues:StringLike": {
            "dynamodb:LeadingKeys": [
              "BRANCH#*",
              "MERCHANT_SETTLEMENT#*"
            ]
          }
        }
      },
      {
        "Sid": "ReadAndPinSettlementScheduleAudit",
        "Effect": "Allow",
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:Query",
          "dynamodb:ConditionCheckItem"
        ],
        "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-PlatformStaff",
        "Condition": {
          "ForAllValues:StringLike": {
            "dynamodb:LeadingKeys": [
              "SETTLEMENT_SCHEDULE_AUDIT#*"
            ]
          }
        }
      }
    ]
  }
}
