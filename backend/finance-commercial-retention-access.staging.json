{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Scoped commercial retention access for existing Staging deletion workers; no execution flags changed.",
  "Conditions": {
    "StagingAccountAndRegion": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::AccountId"
            },
            "699561669180"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::Region"
            },
            "us-east-1"
          ]
        }
      ]
    }
  },
  "Resources": {
    "WorkerCommercialRetention": {
      "Type": "AWS::IAM::Policy",
      "Condition": "StagingAccountAndRegion",
      "Properties": {
        "PolicyName": "CommercialRetention61Worker",
        "Roles": [
          "staging-account-deletion-WorkerRole-u5xpbVRU9G0Q"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:Query",
                "dynamodb:ConditionCheckItem"
              ],
              "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-PlatformStaff",
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "COMMERCIAL_AGREEMENT#*",
                    "DISCOUNT_FUNDING#*"
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:DeleteItem",
                "dynamodb:ConditionCheckItem"
              ],
              "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-PlatformStaff",
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "AUDIT"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "ExpiryCommercialRetention": {
      "Type": "AWS::IAM::Policy",
      "Condition": "StagingAccountAndRegion",
      "Properties": {
        "PolicyName": "CommercialRetention61Expiry",
        "Roles": [
          "staging-account-deletion-FinancialExpiryRole-IuLxJxc5s29r"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:DeleteItem",
                "dynamodb:ConditionCheckItem"
              ],
              "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-MerchantPlatform",
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "COMMERCIAL_AGREEMENT#*",
                    "BRANCH#*"
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:DeleteItem",
                "dynamodb:ConditionCheckItem"
              ],
              "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-PlatformStaff",
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "COMMERCIAL_AGREEMENT#*",
                    "DISCOUNT_FUNDING#*",
                    "AUDIT"
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:ConditionCheckItem"
              ],
              "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/WhizzMerchants_Businesses"
            },
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:ConditionCheckItem"
              ],
              "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-AccountDeletion",
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "BUSINESS_LIFECYCLE#MERCHANT#*",
                    "SUBJECT#MERCHANT#*"
                  ]
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "dynamodb:GetItem",
                "dynamodb:ConditionCheckItem"
              ],
              "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-Wallets",
              "Condition": {
                "ForAllValues:StringLike": {
                  "dynamodb:LeadingKeys": [
                    "WALLET#MERCHANT#*"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
