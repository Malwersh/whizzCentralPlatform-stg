{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Staging Mapbox routing credential container. Value initialized separately; no Lambda or IAM changes.",
  "Conditions": {
    "StagingAccountAndRegion": {
      "Fn::And": [
        { "Fn::Equals": [{ "Ref": "AWS::AccountId" }, "699561669180"] },
        { "Fn::Equals": [{ "Ref": "AWS::Region" }, "us-east-1"] }
      ]
    }
  },
  "Resources": {
    "MapboxRoutingCredential": {
      "Type": "AWS::SecretsManager::Secret",
      "Condition": "StagingAccountAndRegion",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "wizz/staging/maps/mapbox",
        "Description": "Mapbox routing server credential JSON with accessToken field; initialize before use.",
        "Tags": [{ "Key": "Environment", "Value": "staging" }, { "Key": "Purpose", "Value": "delivery-routing" }]
      }
    }
  },
  "Outputs": {
    "MapboxSecretArn": {
      "Condition": "StagingAccountAndRegion",
      "Value": { "Ref": "MapboxRoutingCredential" }
    }
  }
}
