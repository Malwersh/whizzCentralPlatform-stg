    "Environment": {
      "Type": "String",
      "Default": "staging",
      "AllowedValues": [
        "staging"
      ]
    },
    "MerchantStaffPermissionMode": {
      "Type": "String",
      "Default": "CENTRAL",
      "AllowedValues": [
        "CENTRAL"
      ]
    },
