      "Type": "String",
      "Default": "staging-AuditLog"
    },
    "IdempotencyKeysTableName": {
      "Type": "String",
      "Default": "staging-IdempotencyKeys"
    },
    "WalletNotificationsTableName": {
      "Type": "String",
      "Default": "staging-WalletNotifications"
    },
    "WalletApiId": {
      "Type": "String",
      "Default": "z14s5f8oxh"
    },
    "BranchDeviceResourceId": {
      "Type": "String",
      "Default": "wkm2t0"
    },
    "WalletAuthorizerId": {
      "Type": "String",
      "Default": "2bqq12"
    },
    "WalletAuthorizerRoleName": {
      "Type": "String",
      "Default": "staging-wizz-wallet-servi-WalletAuthorizerFunctionR-dNShlP21Ntcz"
    }
  },
