        "Roles": [
          {
            "Ref": "Cod26WalletNotificationWorkerRoleName"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
