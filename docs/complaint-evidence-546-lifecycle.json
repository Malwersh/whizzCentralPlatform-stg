      },
      "Expiration": {
        "Days": 30
      }
    },
    {
      "ID": "AbortIncompleteSupportUploads",
      "Status": "Enabled",
      "Filter": {
        "Prefix": ""
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 1
      }
    }
  ]
}
