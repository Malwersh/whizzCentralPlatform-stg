{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadReturnOperationsPolicy",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-PlatformStaff",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "OPERATIONAL_SETTINGS#RETURN_OPERATIONS"
          ]
        }
      }
    },
    {
      "Sid": "OwnerReturnAcceptanceMetadataOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-MerchantPlatform",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "RETURN_ACCEPTANCE#*"
          ]
        }
      }
    }
  ]
}
