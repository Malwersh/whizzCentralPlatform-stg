{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:us-east-1:699561669180:table/staging-Holds",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:Attributes": [
            "orderId",
            "sk",
            "customerId",
            "caseId",
            "supportSessionId"
          ]
        },
        "Null": {
          "dynamodb:Attributes": "false"
        }
      }
    }
  ]
}
