{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Production administration driver reviews and temporary private document view. Runtime JWT plus live staff checks. Initially disabled.",
  "Parameters": {
    "ExpectedAccountId": {
      "Type": "String",
      "Default": "746727375268",
      "AllowedValues": [
        "746727375268"
      ]
    },
    "DriverReviewReadEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "DriverReviewWritesEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "ArtifactKey": {
      "Type": "String",
      "AllowedPattern": "driver-review/[a-f0-9]{64}.zip"
    },
    "ArtifactVersion": {
      "Type": "String",
      "MinLength": 1
    }
  },
  "Rules": {
    "ProductionAccountOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "ExpectedAccountId"
              },
              "746727375268"
            ]
          },
          "AssertDescription": "Approved production account only."
        }
      ]
    }
  },
  "Conditions": {
    "IsProductionAccount": {
      "Fn::Equals": [
        {
          "Ref": "AWS::AccountId"
        },
        {
          "Ref": "ExpectedAccountId"
        }
      ]
    }
  },
  "Resources": {
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "IsProductionAccount",
      "Properties": {
        "LogGroupName": "/aws/lambda/wizz-production-driver-review",
        "RetentionInDays": 90
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Condition": "IsProductionAccount",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DriverAdministrativeReviewOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:Scan"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-Drivers"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/wizz-production-driver-review:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-Drivers"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:Scan",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-RegionsDerived"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-PlatformStaff"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "EMPLOYEE#*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-PlatformStaff"
                  },
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "dynamodb:LeadingKeys": [
                        "AUDIT"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-AccountDeletion"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "ACCOUNT_LIFECYCLE#DRIVER#*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cognito-idp:AdminGetUser"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cognito-idp:${AWS::Region}:${AWS::AccountId}:userpool/us-east-1_njh6vaNWj"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::wizz-production-driver-documents-746727375268-us-east-1/drivers/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-DriverPerformanceSnapshots"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "DRIVER#*",
                        "CONTROL"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-AccountDeletion"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "ACCOUNT_LIFECYCLE#DRIVER#*",
                        "SUBJECT#DRIVER#*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Condition": "IsProductionAccount",
      "Properties": {
        "FunctionName": "wizz-production-driver-review",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "MemorySize": 256,
        "Timeout": 25,
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": "wizz-production-artifacts-746727375268-us-east-1",
          "S3Key": {
            "Ref": "ArtifactKey"
          },
          "S3ObjectVersion": {
            "Ref": "ArtifactVersion"
          }
        },
        "Environment": {
          "Variables": {
            "ENVIRONMENT": "production",
            "DRIVER_REVIEW_ENABLED": {
              "Ref": "DriverReviewWritesEnabled"
            },
            "DRIVER_REVIEW_READ_ENABLED": {
              "Ref": "DriverReviewReadEnabled"
            }
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "LogGroup"
          }
        }
      }
    },
    "Api": {
      "Type": "AWS::ApiGateway::RestApi",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Name": "wizz-production-driver-review",
        "EndpointConfiguration": {
          "Types": [
            "REGIONAL"
          ]
        }
      }
    },
    "StaffResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Fn::GetAtt": [
            "Api",
            "RootResourceId"
          ]
        },
        "PathPart": "staff"
      }
    },
    "DriversResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "StaffResource"
        },
        "PathPart": "drivers"
      }
    },
    "DriverResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "DriversResource"
        },
        "PathPart": "{driverId}"
      }
    },
    "VehiclesResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "DriverResource"
        },
        "PathPart": "vehicles"
      }
    },
    "DocumentsResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "DriverResource"
        },
        "PathPart": "documents"
      }
    },
    "ViewResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "DocumentsResource"
        },
        "PathPart": "view"
      }
    },
    "PerformanceResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "DriverResource"
        },
        "PathPart": "performance"
      }
    },
    "DeletionResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "DriverResource"
        },
        "PathPart": "account-deletion"
      }
    },
    "DirectoryMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ResourceId": {
          "Ref": "DriversResource"
        },
        "HttpMethod": "GET",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${Function.Arn}/invocations"
          }
        }
      }
    },
    "DirectoryInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/production/GET/staff/drivers"
        }
      }
    },
    "ReadMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ResourceId": {
          "Ref": "VehiclesResource"
        },
        "HttpMethod": "GET",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${Function.Arn}/invocations"
          }
        }
      }
    },
    "ReadInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/production/GET/staff/drivers/*/vehicles"
        }
      }
    },
    "ReviewMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ResourceId": {
          "Ref": "VehiclesResource"
        },
        "HttpMethod": "POST",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${Function.Arn}/invocations"
          }
        }
      }
    },
    "ReviewInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/production/POST/staff/drivers/*/vehicles"
        }
      }
    },
    "ViewMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ResourceId": {
          "Ref": "ViewResource"
        },
        "HttpMethod": "GET",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${Function.Arn}/invocations"
          }
        }
      }
    },
    "ViewInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/production/GET/staff/drivers/*/documents/view"
        }
      }
    },
    "PerformanceMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ResourceId": {
          "Ref": "PerformanceResource"
        },
        "HttpMethod": "GET",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${Function.Arn}/invocations"
          }
        }
      }
    },
    "PerformanceInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/production/GET/staff/drivers/*/performance"
        }
      }
    },
    "DeletionMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ResourceId": {
          "Ref": "DeletionResource"
        },
        "HttpMethod": "GET",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${Function.Arn}/invocations"
          }
        }
      }
    },
    "DeletionInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/production/GET/staff/drivers/*/account-deletion"
        }
      }
    },
    "AccountDeletionDeployment": {
      "Type": "AWS::ApiGateway::Deployment",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        }
      },
      "DependsOn": [
        "DirectoryMethod",
        "ReadMethod",
        "ReviewMethod",
        "ViewMethod",
        "PerformanceMethod",
        "DeletionMethod"
      ]
    },
    "Stage": {
      "Type": "AWS::ApiGateway::Stage",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "DeploymentId": {
          "Ref": "AccountDeletionDeployment"
        },
        "StageName": "production",
        "MethodSettings": [
          {
            "ResourcePath": "/*",
            "HttpMethod": "*",
            "ThrottlingBurstLimit": 10,
            "ThrottlingRateLimit": 5,
            "DataTraceEnabled": false
          }
        ]
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Value": {
        "Fn::Sub": "https://${Api}.execute-api.${AWS::Region}.amazonaws.com/production"
      }
    }
  }
}
