{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private production administration bootstrap hosting; no business data or old platform copied.",
  "Parameters": {
    "ExpectedAccountId": {
      "Type": "String",
      "Default": "746727375268",
      "AllowedValues": [
        "746727375268"
      ]
    },
    "LogRetentionDays": {
      "Type": "Number",
      "Default": 90,
      "AllowedValues": [
        30,
        60,
        90,
        180,
        365
      ]
    }
  },
  "Rules": {
    "ProductionAccountOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "ExpectedAccountId"
              },
              "746727375268"
            ]
          },
          "AssertDescription": "Only the approved production account is permitted."
        }
      ]
    }
  },
  "Conditions": {
    "IsProductionAccount": {
      "Fn::Equals": [
        {
          "Ref": "AWS::AccountId"
        },
        {
          "Ref": "ExpectedAccountId"
        }
      ]
    }
  },
  "Resources": {
    "WebBucket": {
      "Type": "AWS::S3::Bucket",
      "Condition": "IsProductionAccount",
      "Properties": {
        "BucketName": "wizz-production-admin-web-746727375268-us-east-1",
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Condition": "IsProductionAccount",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": "wizz-production-admin-web",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "NoCache": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Condition": "IsProductionAccount",
      "Properties": {
        "CachePolicyConfig": {
          "Name": "wizz-production-admin-no-cache",
          "MinTTL": 0,
          "DefaultTTL": 0,
          "MaxTTL": 0,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": false,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "ApiRequestPolicy": {
      "Type": "AWS::CloudFront::OriginRequestPolicy",
      "Condition": "IsProductionAccount",
      "Properties": {
        "OriginRequestPolicyConfig": {
          "Name": "wizz-production-admin-api-request",
          "HeadersConfig": {
            "HeaderBehavior": "allExcept",
            "Headers": [
              "Host"
            ]
          },
          "CookiesConfig": {
            "CookieBehavior": "none"
          },
          "QueryStringsConfig": {
            "QueryStringBehavior": "all"
          }
        }
      }
    },
    "SecurityHeaders": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Condition": "IsProductionAccount",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": "wizz-production-admin-web-security",
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "FrameOptions": {
              "FrameOption": "DENY",
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "no-referrer",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "Override": true
            },
            "ContentSecurityPolicy": {
              "ContentSecurityPolicy": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://cognito-idp.us-east-1.amazonaws.com; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'",
              "Override": true
            }
          },
          "CustomHeadersConfig": {
            "Items": [
              {
                "Header": "Cache-Control",
                "Value": "no-store",
                "Override": true
              }
            ]
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Condition": "IsProductionAccount",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Wizz production administration bootstrap",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2",
          "PriceClass": "PriceClass_100",
          "Origins": [
            {
              "Id": "web",
              "DomainName": {
                "Fn::GetAtt": [
                  "WebBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "OriginAccess"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            },
            {
              "Id": "session",
              "DomainName": "y6vmu5snh3.execute-api.us-east-1.amazonaws.com",
              "OriginPath": "/production",
              "CustomOriginConfig": {
                "HTTPSPort": 443,
                "OriginProtocolPolicy": "https-only",
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ]
              }
            }
          ],
          "DefaultCacheBehavior": {
            "ViewerProtocolPolicy": "redirect-to-https",
            "CachePolicyId": {
              "Ref": "NoCache"
            },
            "ResponseHeadersPolicyId": {
              "Ref": "SecurityHeaders"
            },
            "TargetOriginId": "web",
            "AllowedMethods": [
              "GET",
              "HEAD",
              "OPTIONS"
            ]
          },
          "CacheBehaviors": [
            {
              "ViewerProtocolPolicy": "redirect-to-https",
              "CachePolicyId": {
                "Ref": "NoCache"
              },
              "ResponseHeadersPolicyId": {
                "Ref": "SecurityHeaders"
              },
              "PathPattern": "/staff/*",
              "TargetOriginId": "session",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "OriginRequestPolicyId": {
                "Ref": "ApiRequestPolicy"
              }
            }
          ],
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 500,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 502,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 503,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 504,
              "ErrorCachingMinTTL": 0
            }
          ],
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          }
        }
      }
    },
    "WebBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Bucket": {
          "Ref": "WebBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${WebBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "WebBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${WebBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "WebsiteUrl": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "WebBucketName": {
      "Value": {
        "Ref": "WebBucket"
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    }
  }
}
