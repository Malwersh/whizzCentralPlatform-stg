{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private production financial cancellation and driver unassignment for production orders.",
  "Parameters": {
    "ExpectedAccountId": {
      "Type": "String",
      "Default": "746727375268",
      "AllowedValues": [
        "746727375268"
      ]
    },
    "ArtifactKey": {
      "Type": "String",
      "AllowedPattern": "order-financial/[a-f0-9]{64}\\.zip"
    },
    "ArtifactVersion": {
      "Type": "String",
      "MinLength": 1
    },
    "HostMode": {
      "Type": "String",
      "Default": "OFF",
      "AllowedValues": [
        "OFF",
        "SCOPED",
        "GENERAL"
      ]
    },
    "RolloutConfig": {
      "Type": "String",
      "Default": "{}",
      "NoEcho": true
    },
    "RolloutSha256": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^(?:[a-f0-9]{64})?$"
    }
  },
  "Rules": {
    "ProductionAccountOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "ExpectedAccountId"
              },
              "746727375268"
            ]
          },
          "AssertDescription": "Approved production account only."
        }
      ]
    }
  },
  "Conditions": {
    "IsProductionAccount": {
      "Fn::Equals": [
        {
          "Ref": "AWS::AccountId"
        },
        {
          "Ref": "ExpectedAccountId"
        }
      ]
    },
    "EnabledProductionOrderHost": {
      "Fn::And": [
        {
          "Condition": "IsProductionAccount"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "HostMode"
                },
                "OFF"
              ]
            }
          ]
        }
      ]
    },
    "GeneralProductionOrderHost": {
      "Fn::And": [
        {
          "Condition": "IsProductionAccount"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "HostMode"
            },
            "GENERAL"
          ]
        }
      ]
    }
  },
  "Resources": {
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/aws/lambda/wizz-production-order-financial",
        "RetentionInDays": 90
      },
      "Condition": "IsProductionAccount"
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
