          {
            "PolicyName": "WriteOrderFinancialLogs",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/wizz-production-order-financial:*"
                  }
                }
              ]
            }
          },
          {
            "Fn::If": [
              "EnabledProductionOrderHost",
              {
