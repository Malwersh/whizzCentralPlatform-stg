{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Internal driver wallet creation with lifecycle fencing; no funding.",
  "Parameters": {
    "ExpectedAccountId": {
      "Type": "String",
      "Default": "746727375268",
      "AllowedValues": [
        "746727375268"
      ]
    },
    "ArtifactKey": {
      "Type": "String",
      "AllowedPattern": "driver-wallet/[a-f0-9]{64}.zip"
    },
    "ArtifactVersion": {
      "Type": "String",
      "MinLength": 1
    },
    "WalletCreationEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    }
  },
  "Rules": {
    "ProductionAccountOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "ExpectedAccountId"
              },
              "746727375268"
            ]
          },
          "AssertDescription": "Approved production account only."
        }
      ]
    }
  },
  "Conditions": {
    "IsProductionAccount": {
      "Fn::Equals": [
        {
          "Ref": "AWS::AccountId"
        },
        {
          "Ref": "ExpectedAccountId"
        }
      ]
    }
  },
  "Resources": {
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/aws/lambda/wizz-production-wallet-creation-trigger",
        "RetentionInDays": 90
      },
      "Condition": "IsProductionAccount"
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CreateDriverWalletOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/wizz-production-wallet-creation-trigger:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-Wallets"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "WALLET#DRIVER#*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-AccountDeletion"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "ACCOUNT_LIFECYCLE#DRIVER#*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      "Condition": "IsProductionAccount"
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "wizz-production-wallet-creation-trigger",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "MemorySize": 128,
        "Timeout": 15,
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": "wizz-production-artifacts-746727375268-us-east-1",
          "S3Key": {
            "Ref": "ArtifactKey"
          },
          "S3ObjectVersion": {
            "Ref": "ArtifactVersion"
          }
        },
        "Environment": {
          "Variables": {
            "ENVIRONMENT": "production",
            "WALLET_CREATION_ENABLED": {
              "Ref": "WalletCreationEnabled"
            }
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "LogGroup"
          }
        }
      },
      "Condition": "IsProductionAccount"
    }
  }
}
