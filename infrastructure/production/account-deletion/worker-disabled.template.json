{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Production customer deletion worker with scoped resource bindings and execution disabled.",
  "Parameters": {
    "ArtifactKey": {
      "Type": "String",
      "AllowedPattern": "customer-deletion/[a-f0-9]{64}[.]zip"
    },
    "ArtifactVersion": {
      "Type": "String",
      "MinLength": 1
    },
    "SupportSocketId": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9]{10}"
    },
    "ExecutionEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
  "Conditions": {
    "ProductionOnly": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::AccountId"
            },
            "746727375268"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::Region"
            },
            "us-east-1"
          ]
        }
      ]
    },
    "ExecutionOn": {
      "Fn::And": [
        {
          "Condition": "ProductionOnly"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "ExecutionEnabled"
            },
            "true"
          ]
        }
      ]
    }
  },
