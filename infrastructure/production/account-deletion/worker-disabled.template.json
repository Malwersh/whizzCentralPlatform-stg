                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:DeleteObject",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::wizz-production-support-attachments-746727375268-us-east-1/support-images/*"
                  }
                },
                {
                  "Effect": "Allow",
