    "Worker": {
      "Condition": "ProductionOnly",
      "Type": "AWS::Lambda::Function",
      "DependsOn": "Logs",
      "Properties": {
        "FunctionName": "wizz-production-customer-deletion-worker",
        "Runtime": "nodejs22.x",
        "Handler": "worker.handler",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "MemorySize": 512,
        "Timeout": 180,
        "Code": {
          "S3Bucket": "wizz-production-artifacts-746727375268-us-east-1",
          "S3Key": {
            "Ref": "ArtifactKey"
          },
          "S3ObjectVersion": {
            "Ref": "ArtifactVersion"
          }
        },
        "Environment": {
          "Variables": {
            "ENVIRONMENT": "production",
            "CUSTOMER_DELETION_ENABLED": {
              "Ref": "ExecutionEnabled"
            },
            "WALLETS_TABLE": "wizz-production-Wallets",
            "LEDGER_TABLE": "wizz-production-LedgerEntries",
            "HOLDS_TABLE": "wizz-production-Holds",
            "TOPUP_REQUESTS_TABLE": "wizz-production-TopupRequests",
            "AUDIT_LOG_TABLE": "wizz-production-AuditLog",
            "IDEMPOTENCY_KEYS_TABLE": "wizz-production-IdempotencyKeys",
            "ACCOUNT_DELETION_TABLE": "wizz-production-AccountDeletion",
            "WALLET_LIFECYCLE_TABLE": "wizz-production-WalletLifecycle",
            "ORDERS_TABLE": "wizz-production-Orders",
            "STAFF_TABLE": "wizz-production-PlatformStaff",
            "MERCHANTS_TABLE": "wizz-production-Merchants",
            "DRIVERS_TABLE": "wizz-production-Drivers",
            "DISPATCH_JOBS_TABLE": "wizz-production-DispatchJobs",
            "WAVE_OFFERS_TABLE": "wizz-production-WaveOffers",
            "DRIVER_LIVE_STATE_TABLE": "wizz-production-DriverLiveState",
            "OFFER_JOURNEY_TABLE": "wizz-production-OfferJourney",
            "DELIVERY_QUOTES_TABLE": "wizz-production-DeliveryQuotes",
            "SUPPORT_SOCKET_ENDPOINT": {
              "Fn::Sub": "https://${SupportSocketId}.execute-api.${AWS::Region}.amazonaws.com/production"
            },
            "DELIVERY_FUNDING_ARCHIVE_ENABLED": {
              "Ref": "ExecutionEnabled"
            }
          }
        }
      }
    },
    "RetrySchedule": {
      "Type": "AWS::Events::Rule",
      "Condition": "ExecutionOn",
      "Properties": {
        "Name": "wizz-production-customer-deletion-retry",
        "ScheduleExpression": "rate(1 minute)",
        "State": "ENABLED",
        "Targets": [
          {
            "Arn": {
              "Fn::GetAtt": [
                "Worker",
                "Arn"
              ]
            },
            "Id": "CustomerDeletionWorker",
            "Input": "{\"operation\":\"CUSTOMER_DELETION_SWEEP\"}"
          }
        ]
      }
    },
    "RetryInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "ExecutionOn",
      "Properties": {
        "FunctionName": {
          "Ref": "Worker"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "RetrySchedule",
            "Arn"
          ]
        },
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        }
      }
    }
