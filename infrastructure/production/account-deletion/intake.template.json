{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated production customer deletion intake. Request writes remain gated by the Lambda configuration.",
  "Parameters": {
    "ArtifactKey": {
      "Type": "String",
      "AllowedPattern": "customer-deletion-intake/[a-f0-9]{64}[.]zip"
    },
    "ArtifactVersion": {
      "Type": "String",
      "MinLength": 1
    },
    "OtpSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:us-east-1:746727375268:secret:wizz/production/customer/otp-[A-Za-z0-9]+"
    },
    "ExecutionEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
  "Conditions": {
    "ProductionOnly": {
      "Fn::And": [
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::AccountId"
            },
            "746727375268"
          ]
        },
        {
          "Fn::Equals": [
            {
              "Ref": "AWS::Region"
            },
            "us-east-1"
          ]
        }
      ]
    },
    "ExecutionOn": {
      "Fn::And": [
        {
          "Condition": "ProductionOnly"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "ExecutionEnabled"
            },
            "true"
          ]
        }
      ]
    }
  },
  "Resources": {
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "ProductionOnly",
      "Properties": {
        "LogGroupName": "/aws/lambda/wizz-production-customer-deletion-intake",
        "RetentionInDays": 90
      }
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Condition": "ProductionOnly",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeletionIntake",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/wizz-production-customer-deletion-intake:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-Customers"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-Wallets"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "WALLET#CUSTOMER#*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:Query",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-OfferJourney"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:Scan",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-Orders"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-Holds"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-TopupRequests"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-IdempotencyKeys"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-WalletLifecycle"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-DispatchJobs"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-PlatformStaff"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-SupportChatSessions"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-SupportAttachments"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "dynamodb:GetItem",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-PlatformStaff"
                  },
                  "Condition": {
                    "ForAllValues:StringEquals": {
                      "dynamodb:LeadingKeys": [
                        "OPERATIONAL_SETTINGS#ACCOUNT_DELETION"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-AccountDeletion"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "SUBJECT#CUSTOMER#*",
                        "VERIFY_ACTIVE#CUSTOMER#*",
                        "DELETE_COOLDOWN#CUSTOMER#*",
                        "DELETE_DAILY#*#CUSTOMER#*",
                        "DELETE_GLOBAL#*",
                        "CHALLENGE#*",
                        "RECEIPT#*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "OtpSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-PlatformStaff"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "DELIVERY_RESERVATION#*",
                        "DELIVERY_USAGE#*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Condition": "ProductionOnly",
      "Properties": {
        "FunctionName": "wizz-production-customer-deletion-intake",
        "Runtime": "nodejs22.x",
        "Handler": "intake.handler",
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": "wizz-production-artifacts-746727375268-us-east-1",
          "S3Key": {
            "Ref": "ArtifactKey"
          },
          "S3ObjectVersion": {
            "Ref": "ArtifactVersion"
          }
        },
        "Timeout": 29,
        "MemorySize": 512,
        "Environment": {
          "Variables": {
            "ENVIRONMENT": "production",
            "DELETION_OTP_SECRET_ARN": {
              "Ref": "OtpSecretArn"
            },
            "CUSTOMER_DELETION_INTAKE_ENABLED": {
              "Ref": "ExecutionEnabled"
            },
            "DELIVERY_FUNDING_ARCHIVE_ENABLED": {
              "Ref": "ExecutionEnabled"
            }
          }
        }
      },
      "DependsOn": "Logs"
    },
    "Api": {
      "Type": "AWS::ApiGateway::RestApi",
      "Condition": "ProductionOnly",
      "Properties": {
        "Name": "wizz-production-customer-deletion-intake",
        "EndpointConfiguration": {
          "Types": [
            "REGIONAL"
          ]
        }
      }
    },
    "Deletion": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "ProductionOnly",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Fn::GetAtt": [
            "Api",
            "RootResourceId"
          ]
        },
        "PathPart": "deletion"
      }
    },
    "Proxy": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "ProductionOnly",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "Deletion"
        },
        "PathPart": "{proxy+}"
      }
    },
    "Method": {
      "Type": "AWS::ApiGateway::Method",
      "Condition": "ProductionOnly",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ResourceId": {
          "Ref": "Proxy"
        },
        "HttpMethod": "ANY",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${Function.Arn}/invocations"
          }
        }
      }
    },
    "Permission": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "ProductionOnly",
      "Properties": {
        "FunctionName": {
          "Ref": "Function"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/production/*/deletion/*"
        }
      }
    },
    "Deployment": {
      "Type": "AWS::ApiGateway::Deployment",
      "Condition": "ProductionOnly",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        }
      },
      "DependsOn": "Method"
    },
    "Stage": {
      "Type": "AWS::ApiGateway::Stage",
      "Condition": "ProductionOnly",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "DeploymentId": {
          "Ref": "Deployment"
        },
        "StageName": "production",
        "MethodSettings": [
          {
            "ResourcePath": "/*",
            "HttpMethod": "*",
            "ThrottlingRateLimit": 10,
            "ThrottlingBurstLimit": 20,
            "DataTraceEnabled": false
          }
        ]
      }
    }
  },
  "Outputs": {
    "BaseUrl": {
      "Condition": "ProductionOnly",
      "Value": {
        "Fn::Sub": "https://${Api}.execute-api.${AWS::Region}.amazonaws.com/production"
      }
    }
  }
}
