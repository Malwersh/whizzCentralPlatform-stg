            "Status": "200"
          },
          {
            "Source": "/staff/regions/manage",
            "Target": "https://dkih4prjga.execute-api.us-east-1.amazonaws.com/production/staff/regions/manage",
            "Status": "200"
          },
          {
            "Source": "/staff/regions/manage/history/<regionId>",
            "Target": "https://dkih4prjga.execute-api.us-east-1.amazonaws.com/production/staff/regions/manage/history/<regionId>",
            "Status": "200"
          },
          {
            "Source": "/staff/regions/manage/jobs/<jobId>",
            "Target": "https://dkih4prjga.execute-api.us-east-1.amazonaws.com/production/staff/regions/manage/jobs/<jobId>",
            "Status": "200"
          },
          {
            "Source": "/staff/regions/manage/validate",
            "Target": "https://dkih4prjga.execute-api.us-east-1.amazonaws.com/production/staff/regions/manage/validate",
            "Status": "200"
          },
          {
            "Source": "/staff/regions/manage/validate-plan",
            "Target": "https://dkih4prjga.execute-api.us-east-1.amazonaws.com/production/staff/regions/manage/validate-plan",
            "Status": "200"
          },
          {
            "Source": "/staff/regions/manage/draft",
            "Target": "https://dkih4prjga.execute-api.us-east-1.amazonaws.com/production/staff/regions/manage/draft",
            "Status": "200"
          },
          {
            "Source": "/staff/regions/manage/discard",
            "Target": "https://dkih4prjga.execute-api.us-east-1.amazonaws.com/production/staff/regions/manage/discard",
            "Status": "200"
          },
          {
            "Source": "/staff/regions/manage/cancel",
            "Target": "https://dkih4prjga.execute-api.us-east-1.amazonaws.com/production/staff/regions/manage/cancel",
            "Status": "200"
          },
          {
            "Source": "/staff/regions/manage/publish",
            "Target": "https://dkih4prjga.execute-api.us-east-1.amazonaws.com/production/staff/regions/manage/publish",
            "Status": "200"
          },
          {
            "Source": "/staff/me",
            "Target": "https://y6vmu5snh3.execute-api.us-east-1.amazonaws.com/production/staff/me",
            "Status": "200"
          },
          {
            "Source": "/staff/enrollment/finish",
            "Target": "https://y6vmu5snh3.execute-api.us-east-1.amazonaws.com/production/staff/enrollment/finish",
            "Status": "200"
          },
          {
            "Source": "/staff/drivers",
            "Target": "https://q8do9c7wba.execute-api.us-east-1.amazonaws.com/production/staff/drivers",
            "Status": "200"
          },
          {
            "Source": "/staff/drivers/<driverId>/vehicles",
            "Target": "https://q8do9c7wba.execute-api.us-east-1.amazonaws.com/production/staff/drivers/<driverId>/vehicles",
            "Status": "200"
          },
          {
            "Source": "/staff/drivers/<driverId>/documents/view",
            "Target": "https://q8do9c7wba.execute-api.us-east-1.amazonaws.com/production/staff/drivers/<driverId>/documents/view",
            "Status": "200"
          },
          {
            "Source": "/",
            "Target": "/index.html",
            "Status": "200"
          }
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": "production"
          },
          {
            "Key": "Purpose",
            "Value": "admin-bootstrap"
          }
        ]
      }
    },
    "ProductionBranch": {
      "Type": "AWS::Amplify::Branch",
      "Condition": "IsProductionAccount",
      "Properties": {
        "AppId": {
          "Fn::GetAtt": [
            "AdminApp",
            "AppId"
          ]
        },
        "BranchName": "production",
        "Stage": "PRODUCTION",
        "EnableAutoBuild": false,
        "EnablePullRequestPreview": false,
        "EnablePerformanceMode": false
      }
    }
  },
  "Outputs": {
    "AppId": {
      "Value": {
        "Fn::GetAtt": [
          "AdminApp",
          "AppId"
        ]
      }
    },
    "WebsiteUrl": {
      "Value": {
        "Fn::Sub": "https://production.${AdminApp.DefaultDomain}"
      }
    }
  }
}
