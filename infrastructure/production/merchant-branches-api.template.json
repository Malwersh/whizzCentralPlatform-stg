              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                "arn:aws:s3:::wizz-production-merchant-onboarding-746727375268",
                "arn:aws:s3:::wizz-production-merchant-onboarding-746727375268/*"
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "Businesses": {
      "Type": "AWS::ApiGateway::Resource",
