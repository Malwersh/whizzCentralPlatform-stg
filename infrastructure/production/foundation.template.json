{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "New Wizz production foundation: retained encrypted audit storage and multi-region management-event trail. No application data or identities imported.",
  "Parameters": {
    "ExpectedAccountId": {
      "Type": "String",
      "Default": "746727375268",
      "AllowedValues": [
        "746727375268"
      ]
    },
    "LogRetentionDays": {
      "Type": "Number",
      "Default": 90,
      "AllowedValues": [
        30,
        60,
        90,
        180,
        365
      ]
    }
  },
  "Rules": {
    "ProductionAccountOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "ExpectedAccountId"
              },
              "746727375268"
            ]
          },
          "AssertDescription": "Only the approved production account is permitted."
        }
      ]
    }
  },
  "Conditions": {
    "IsProductionAccount": {
      "Fn::Equals": [
        {
          "Ref": "AWS::AccountId"
        },
        {
          "Ref": "ExpectedAccountId"
        }
      ]
    }
  },
  "Resources": {
    "AuditBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "wizz-production-audit-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": "production"
          },
          {
            "Key": "Purpose",
            "Value": "audit"
          }
        ]
      },
      "Condition": "IsProductionAccount"
    },
    "AuditBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AuditBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "AuditBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${AuditBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "CloudTrailBucketAcl",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:GetBucketAcl",
              "Resource": {
                "Fn::GetAtt": [
                  "AuditBucket",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/wizz-production-management"
                  }
                }
              }
            },
            {
              "Sid": "CloudTrailWrite",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${AuditBucket.Arn}/AWSLogs/${AWS::AccountId}/*"
              },
              "Condition": {
                "StringEquals": {
                  "s3:x-amz-acl": "bucket-owner-full-control",
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/wizz-production-management"
                  }
                }
              }
            }
          ]
        }
      },
      "Condition": "IsProductionAccount"
    },
    "AuditLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": "/wizz/production/audit",
        "RetentionInDays": {
          "Ref": "LogRetentionDays"
        }
      },
      "Condition": "IsProductionAccount"
    },
    "AuditDeliveryRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/wizz-production-management"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DeliverProductionAudit",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/wizz/production/audit:log-stream:${AWS::AccountId}_CloudTrail_*"
                  }
                }
              ]
            }
          }
        ]
      },
      "Condition": "IsProductionAccount"
    },
    "ManagementTrail": {
      "Type": "AWS::CloudTrail::Trail",
      "DependsOn": [
        "AuditBucketPolicy"
      ],
      "Properties": {
        "TrailName": "wizz-production-management",
        "S3BucketName": {
          "Ref": "AuditBucket"
        },
        "IsLogging": true,
        "IsMultiRegionTrail": true,
        "IncludeGlobalServiceEvents": true,
        "EnableLogFileValidation": true,
        "CloudWatchLogsLogGroupArn": {
          "Fn::GetAtt": [
            "AuditLogGroup",
            "Arn"
          ]
        },
        "CloudWatchLogsRoleArn": {
          "Fn::GetAtt": [
            "AuditDeliveryRole",
            "Arn"
          ]
        },
        "EventSelectors": [
          {
            "IncludeManagementEvents": true,
            "ReadWriteType": "All",
            "DataResources": []
          }
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": "production"
          }
        ]
      },
      "Condition": "IsProductionAccount"
    }
  },
  "Outputs": {
    "AuditBucketName": {
      "Condition": "IsProductionAccount",
      "Value": {
        "Ref": "AuditBucket"
      }
    },
    "TrailArn": {
      "Condition": "IsProductionAccount",
      "Value": {
        "Fn::GetAtt": [
          "ManagementTrail",
          "Arn"
        ]
      }
    },
    "AuditLogGroupName": {
      "Condition": "IsProductionAccount",
      "Value": {
        "Ref": "AuditLogGroup"
      }
    }
  }
}
