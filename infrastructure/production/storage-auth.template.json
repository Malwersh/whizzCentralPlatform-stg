  "Outputs": {
    "MerchantFinancialSessionsTableName": {
      "Condition": "IsProductionAccount",
      "Value": {
        "Ref": "MerchantFinancialSessionsTable"
      }
    },
    "CustomerPhoneAuthTableName": {
      "Value": {
        "Ref": "CustomerPhoneAuthTable"
      }
    },
    "CustomerPhoneLinkTableName": {
      "Value": {
        "Ref": "CustomerPhoneLinkTable"
      }
    },
    "DriverOtpSessionsTableName": {
      "Value": {
        "Ref": "DriverOtpSessionsTable"
      }
    },
    "DriversTableName": {
      "Value": {
        "Ref": "DriversTable"
      }
    },
    "PlatformStaffTableName": {
      "Value": {
        "Ref": "PlatformStaffTable"
      }
    },
    "MerchantPlatformTableName": {
      "Value": {
        "Ref": "MerchantPlatformTable"
      }
    },
    "AccountDeletionTableName": {
      "Value": {
        "Ref": "AccountDeletionTable"
      }
    },
    "AccountDeletionFinancialArchiveTableName": {
      "Value": {
        "Ref": "AccountDeletionFinancialArchiveTable"
      }
    }
  }
}
