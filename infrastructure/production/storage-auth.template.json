      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "wizz-production-MerchantPlatform",
        "BillingMode": "PAY_PER_REQUEST",
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "organizationPk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "organizationSk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "subjectPk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "subjectSk",
            "AttributeType": "S"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": "production"
          },
          {
            "Key": "Project",
            "Value": "Wizz"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "OrganizationIndex",
            "KeySchema": [
              {
                "AttributeName": "organizationPk",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "organizationSk",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          },
          {
            "IndexName": "SubjectIndex",
            "KeySchema": [
              {
                "AttributeName": "subjectPk",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "subjectSk",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          }
        ]
      }
    },
    "AccountDeletionTable": {
      "Type": "AWS::DynamoDB::Table",
      "Condition": "IsProductionAccount",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "wizz-production-AccountDeletion",
        "BillingMode": "PAY_PER_REQUEST",
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
