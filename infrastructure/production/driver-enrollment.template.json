{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Driver enrollment API, OTP disabled pending acceptance; wallet binding independently controlled.",
  "Parameters": {
    "ExpectedAccountId": {
      "Type": "String",
      "Default": "746727375268",
      "AllowedValues": [
        "746727375268"
      ]
    },
    "ArtifactKey": {
      "Type": "String",
      "AllowedPattern": "driver-enrollment/[a-f0-9]{64}.zip"
    },
    "ArtifactVersion": {
      "Type": "String",
      "MinLength": 1
    },
    "OtpSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:us-east-1:746727375268:secret:wizz/production/driver/otp-[A-Za-z0-9]+"
    },
    "OtpEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "WalletBindingReady": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    }
  },
  "Rules": {
    "ProductionAccountOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "ExpectedAccountId"
              },
              "746727375268"
            ]
          },
          "AssertDescription": "Approved production account only."
        }
      ]
    }
  },
  "Conditions": {
    "IsProductionAccount": {
      "Fn::Equals": [
        {
          "Ref": "AWS::AccountId"
        },
        {
          "Ref": "ExpectedAccountId"
        }
      ]
    }
  },
  "Resources": {
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "IsProductionAccount",
      "Properties": {
        "LogGroupName": "/aws/lambda/wizz-production-driver-enrollment",
        "RetentionInDays": 90
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Role": {
      "Type": "AWS::IAM::Role",
      "Condition": "IsProductionAccount",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DriverEnrollmentOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/wizz-production-driver-enrollment:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-DriverOtpSessions"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-Drivers"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-Wallets"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "WALLET#DRIVER#*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:ConditionCheckItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/wizz-production-AccountDeletion"
                  },
                  "Condition": {
                    "ForAllValues:StringLike": {
                      "dynamodb:LeadingKeys": [
                        "ACCOUNT_LIFECYCLE#DRIVER#*",
                        "DRIVER_PHONE_CLOSURE#*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "OtpSecretArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cognito-idp:ListUsers",
                    "cognito-idp:AdminCreateUser",
                    "cognito-idp:AdminSetUserPassword",
                    "cognito-idp:AdminUpdateUserAttributes"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cognito-idp:${AWS::Region}:${AWS::AccountId}:userpool/us-east-1_5sUT54eCB"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:wizz-production-wallet-creation-trigger"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Condition": "IsProductionAccount",
      "Properties": {
        "FunctionName": "wizz-production-driver-enrollment",
        "Runtime": "nodejs22.x",
        "Handler": "index.handler",
        "MemorySize": 256,
        "Timeout": 25,
        "Role": {
          "Fn::GetAtt": [
            "Role",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": "wizz-production-artifacts-746727375268-us-east-1",
          "S3Key": {
            "Ref": "ArtifactKey"
          },
          "S3ObjectVersion": {
            "Ref": "ArtifactVersion"
          }
        },
        "Environment": {
          "Variables": {
            "ENVIRONMENT": "production",
            "OTP_ENABLED": {
              "Ref": "OtpEnabled"
            },
            "USER_POOL_ID": "us-east-1_5sUT54eCB",
            "OTP_TABLE": "wizz-production-DriverOtpSessions",
            "WALLETS_TABLE": "wizz-production-Wallets",
            "OTP_SECRET_ARN": {
              "Ref": "OtpSecretArn"
            },
            "DRIVER_TABLE": "wizz-production-Drivers",
            "WALLET_BINDING_READY": {
              "Ref": "WalletBindingReady"
            }
          }
        },
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "LogGroup"
          }
        }
      }
    },
    "Api": {
      "Type": "AWS::ApiGateway::RestApi",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Name": "wizz-production-driver-enrollment",
        "EndpointConfiguration": {
          "Types": [
            "REGIONAL"
          ]
        },
        "DisableExecuteApiEndpoint": false
      }
    },
    "AuthResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Fn::GetAtt": [
            "Api",
            "RootResourceId"
          ]
        },
        "PathPart": "auth"
      }
    },
    "PhoneResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "AuthResource"
        },
        "PathPart": "phone"
      }
    },
    "SendResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "PhoneResource"
        },
        "PathPart": "send"
      }
    },
    "SendMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ResourceId": {
          "Ref": "SendResource"
        },
        "HttpMethod": "POST",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${Function.Arn}/invocations"
          }
        }
      }
    },
    "SendInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/production/POST/auth/phone/send"
        }
      }
    },
    "VerifyResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ParentId": {
          "Ref": "PhoneResource"
        },
        "PathPart": "verify"
      }
    },
    "VerifyMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "ResourceId": {
          "Ref": "VerifyResource"
        },
        "HttpMethod": "POST",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:${AWS::Partition}:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${Function.Arn}/invocations"
          }
        }
      }
    },
    "VerifyInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/production/POST/auth/phone/verify"
        }
      }
    },
    "Deployment": {
      "Type": "AWS::ApiGateway::Deployment",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        }
      },
      "DependsOn": [
        "SendMethod",
        "VerifyMethod"
      ]
    },
    "Stage": {
      "Type": "AWS::ApiGateway::Stage",
      "Condition": "IsProductionAccount",
      "Properties": {
        "RestApiId": {
          "Ref": "Api"
        },
        "DeploymentId": {
          "Ref": "Deployment"
        },
        "StageName": "production",
        "TracingEnabled": false,
        "MethodSettings": [
          {
            "ResourcePath": "/*",
            "HttpMethod": "*",
            "ThrottlingBurstLimit": 10,
            "ThrottlingRateLimit": 5,
            "DataTraceEnabled": false
          }
        ]
      }
    }
  },
  "Outputs": {
    "ApiUrl": {
      "Value": {
        "Fn::Sub": "https://${Api}.execute-api.${AWS::Region}.amazonaws.com/production"
      }
    }
  }
}
