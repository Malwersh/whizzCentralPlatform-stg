{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Parameters": {
    "ExpectedAccountId": {
      "Type": "String",
      "Default": "746727375268",
      "AllowedValues": [
        "746727375268"
      ]
    }
  },
  "Rules": {
    "ProductionAccountOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "ExpectedAccountId"
              },
              "746727375268"
            ]
          },
          "AssertDescription": "Approved production account only."
        }
      ]
    }
  },
  "Conditions": {
    "IsProductionAccount": {
      "Fn::Equals": [
        {
          "Ref": "AWS::AccountId"
        },
        {
          "Ref": "ExpectedAccountId"
        }
      ]
    }
  },
  "Description": "Empty production tables for dispatch, driver presence and offer usage.",
  "Resources": {
    "WaveOffersTable": {
      "Type": "AWS::DynamoDB::Table",
      "Condition": "IsProductionAccount",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "wizz-production-WaveOffers",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "driverId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "orderId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sentAt",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "orderId",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": "production"
          },
          {
            "Key": "Project",
            "Value": "Wizz"
          },
          {
            "Key": "DataClass",
            "Value": "operations"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "driverId-sentAt-index",
            "KeySchema": [
              {
                "AttributeName": "driverId",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "sentAt",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          }
        ],
        "StreamSpecification": {
          "StreamViewType": "NEW_AND_OLD_IMAGES"
        },
        "TimeToLiveSpecification": {
          "Enabled": true,
          "AttributeName": "ttl"
        }
      }
    },
    "DispatchJobsTable": {
      "Type": "AWS::DynamoDB::Table",
      "Condition": "IsProductionAccount",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "wizz-production-DispatchJobs",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "SK",
            "AttributeType": "S"
          },
          {
            "AttributeName": "orderId",
            "AttributeType": "S"
          },
          {
            "AttributeName": "status",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "orderId",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "SK",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": "production"
          },
          {
            "Key": "Project",
            "Value": "Wizz"
          },
          {
            "Key": "DataClass",
            "Value": "operations"
          }
        ],
        "GlobalSecondaryIndexes": [
          {
            "IndexName": "orderId-index",
            "KeySchema": [
              {
                "AttributeName": "orderId",
                "KeyType": "HASH"
              }
            ],
            "Projection": {
              "ProjectionType": "ALL"
            }
          },
          {
            "IndexName": "DispatchReviewStatus340",
            "KeySchema": [
              {
                "AttributeName": "status",
                "KeyType": "HASH"
              },
              {
                "AttributeName": "orderId",
                "KeyType": "RANGE"
              }
            ],
            "Projection": {
              "ProjectionType": "KEYS_ONLY"
            }
          }
        ],
        "StreamSpecification": {
          "StreamViewType": "NEW_IMAGE"
        }
      }
    },
    "DriverLiveStateTable": {
      "Type": "AWS::DynamoDB::Table",
      "Condition": "IsProductionAccount",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "wizz-production-DriverLiveState",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "driverId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "driverId",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": "production"
          },
          {
            "Key": "Project",
            "Value": "Wizz"
          },
          {
            "Key": "DataClass",
            "Value": "operations"
          }
        ]
      }
    },
    "OfferJourneyTable": {
      "Type": "AWS::DynamoDB::Table",
      "Condition": "IsProductionAccount",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "wizz-production-OfferJourney",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "DeletionProtectionEnabled": true,
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": "production"
          },
          {
            "Key": "Project",
            "Value": "Wizz"
          },
          {
            "Key": "DataClass",
            "Value": "financial"
          }
        ],
        "TimeToLiveSpecification": {
          "Enabled": true,
          "AttributeName": "ttl"
        }
      }
    }
  },
  "Outputs": {
    "WaveOffersTableName": {
      "Condition": "IsProductionAccount",
      "Value": {
        "Ref": "WaveOffersTable"
      }
    },
    "DispatchJobsTableName": {
      "Condition": "IsProductionAccount",
      "Value": {
        "Ref": "DispatchJobsTable"
      }
    },
    "DriverLiveStateTableName": {
      "Condition": "IsProductionAccount",
      "Value": {
        "Ref": "DriverLiveStateTable"
      }
    },
    "OfferJourneyTableName": {
      "Condition": "IsProductionAccount",
      "Value": {
        "Ref": "OfferJourneyTable"
      }
    }
  }
}
