            "CATEGORIES_TABLE": "wizz-production-MenuCategories",
            "PRODUCTS_TABLE": "wizz-production-Products",
            "GLOBAL_PRODUCTS_TABLE": "wizz-production-GlobalProducts",
            "REGION_LISTINGS_TABLE": "wizz-production-RegionListings",
            "MERCHANT_PLATFORM_TABLE": "wizz-production-MerchantPlatform",
            "DISCOVERY_TABLE": "wizz-production-PlatformStaff",
            "ENVIRONMENT": "production",
            "USER_POOL_ID": "us-east-1_rNtNKVsVf",
            "USER_POOL_CLIENT_ID": "3e8p0ouglrprpd0a3pc91du0hg"
          }
        },
        "Code": {
          "S3Bucket": "wizz-production-artifacts-746727375268-us-east-1",
          "S3Key": {
            "Ref": "ArtifactKey"
          },
          "S3ObjectVersion": {
            "Ref": "ArtifactVersion"
          }
        },
        "MemorySize": 512,
        "Timeout": 15,
        "LoggingConfig": {
          "LogGroup": {
            "Ref": "AddressesLogs"
          }
        }
      }
    },
    "AddressesInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "IsProductionAccount",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "FunctionName": {
